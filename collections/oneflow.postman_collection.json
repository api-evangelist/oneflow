            ],
            "url": { "raw": "{{baseUrl}}/contracts/:contract_id/parties/:party_id/participants/:participant_id", "host": ["{{baseUrl}}"], "path": ["contracts", ":contract_id", "parties", ":party_id", "participants", ":participant_id"], "variable": [{ "key": "contract_id", "value": "" }, { "key": "party_id", "value": "" }, { "key": "participant_id", "value": "" }] },
            "description": "Removes a participant from a party on a draft contract. Modeled."
