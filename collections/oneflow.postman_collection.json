            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"signatory\": true\n}" },
            "url": { "raw": "{{baseUrl}}/contracts/:contract_id/parties/:party_id/participants", "host": ["{{baseUrl}}"], "path": ["contracts", ":contract_id", "parties", ":party_id", "participants"], "variable": [{ "key": "contract_id", "value": "" }, { "key": "party_id", "value": "" }] },
            "description": "Adds a participant (signatory or viewer) to a party on a draft contract. Modeled."
          }
        },
