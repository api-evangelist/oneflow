    {
      "name": "Webhooks",
      "item": [
        {
          "name": "List webhooks (modeled)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-oneflow-api-token", "value": "{{apiToken}}" },
              { "key": "x-oneflow-user-email", "value": "{{userEmail}}" }
            ],
            "url": { "raw": "{{baseUrl}}/webhooks", "host": ["{{baseUrl}}"], "path": ["webhooks"] },
            "description": "Lists the webhook subscriptions configured in the account. Modeled."
          }
        },
        {
          "name": "Create a webhook (modeled)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-oneflow-api-token", "value": "{{apiToken}}" },
              { "key": "x-oneflow-user-email", "value": "{{userEmail}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"callback_url\": \"https://example.com/oneflow-webhook\",\n  \"sign_key\": \"secret\",\n  \"subscriptions\": [\"contract:publish\", \"contract:signed\"]\n}" },
            "url": { "raw": "{{baseUrl}}/webhooks", "host": ["{{baseUrl}}"], "path": ["webhooks"] },
            "description": "Creates a webhook subscription that delivers contract lifecycle events to a callback URL. Modeled."
          }
        },
