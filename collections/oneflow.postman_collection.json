            "url": { "raw": "{{baseUrl}}/templates", "host": ["{{baseUrl}}"], "path": ["templates"] },
            "description": "Retrieves the templates available for the specified user."
          }
        },
        {
          "name": "Get template types (modeled)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-oneflow-api-token", "value": "{{apiToken}}" },
              { "key": "x-oneflow-user-email", "value": "{{userEmail}}" }
            ],
            "url": { "raw": "{{baseUrl}}/template_types", "host": ["{{baseUrl}}"], "path": ["template_types"] },
            "description": "Retrieves the template types defined in the account. Modeled."
          }
        }
      ]
    },
    {
      "name": "Workspaces",
      "item": [
        {
          "name": "Get workspaces",
          "request": {
            "method": "GET",
