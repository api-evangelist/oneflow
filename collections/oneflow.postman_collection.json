              { "key": "x-oneflow-user-email", "value": "{{userEmail}}" }
            ],
            "url": { "raw": "{{baseUrl}}/webhooks/:webhook_id", "host": ["{{baseUrl}}"], "path": ["webhooks", ":webhook_id"], "variable": [{ "key": "webhook_id", "value": "" }] },
            "description": "Retrieves a single webhook subscription. Modeled."
          }
        },
        {
          "name": "Delete a webhook (modeled)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "x-oneflow-api-token", "value": "{{apiToken}}" },
              { "key": "x-oneflow-user-email", "value": "{{userEmail}}" }
            ],
            "url": { "raw": "{{baseUrl}}/webhooks/:webhook_id", "host": ["{{baseUrl}}"], "path": ["webhooks", ":webhook_id"], "variable": [{ "key": "webhook_id", "value": "" }] },
            "description": "Deletes a webhook subscription. Modeled."
          }
        }
